# Copy to scripts/local.env (git-ignored) and set your code-signing identity.
# Without it, build-app.sh signs ad-hoc ("-"); macOS then asks again for the
# Microphone/Accessibility permissions after every rebuild.
# Any code-signing certificate in your login Keychain works, for example a self-signed one
# made in Keychain Access (Certificate Assistant > Create a Certificate, type "Code Signing").
# List your identities with: security find-identity -v -p codesigning
# CODESIGN_IDENTITY="Voxum"
